{
  "name": "dart-decimate",
  "version": "0.0.67",
  "description": "Rust-native codebase intelligence for Dart and Flutter module graphs.",
  "license": "MIT",
  "bin": {
    "dart-decimate": "npm/bin/dart-decimate.js",
    "dart-decimate-mcp": "npm/bin/dart-decimate-mcp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgaabdu4/dart-decimate.git"
  },
  "bugs": {
    "url": "https://github.com/sgaabdu4/dart-decimate/issues"
  },
  "homepage": "https://github.com/sgaabdu4/dart-decimate#readme",
  "files": [
    "Cargo.toml",
    "Cargo.lock",
    "README.md",
    "assets",
    "LICENSE",
    "src",
    "npm",
    "!npm/bin-cache"
  ],
  "scripts": {
    "postinstall": "node npm/scripts/postinstall.js",
    "test": "cargo build --release --locked && bun test tests/js/*.test.mjs",
    "test:coverage": "cargo build --release --locked && bun test tests/js/*.test.mjs --coverage --coverage-reporter=lcov --coverage-dir=coverage --reporter=junit --reporter-outfile=coverage/junit.xml",
    "test:performance": "cargo build --release --locked --bin dart-decimate && bun test tests/performance/*.test.mjs --reporter=junit --reporter-outfile=coverage/performance.xml",
    "typecheck": "bun scripts/typecheck-js.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "lint": "bun run version:check && bun run migration:check && bun run lint:js && bun run format:check",
    "lint:js": "biome lint .",
    "format": "biome format --write . && cargo fmt",
    "format:check": "biome format . && cargo fmt --check",
    "version:bump:check": "node scripts/check-pr-version-bump.mjs",
    "release:check": "node scripts/check-release-version.mjs",
    "migration:check": "node scripts/check-dart-decimate-migration.mjs",
    "pack:check": "bun pm pack --dry-run",
    "test:npm": "node npm/bin/dart-decimate.js --help",
    "test:npm:mcp": "printf '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-11-25\"}}\\n' | node npm/bin/dart-decimate-mcp.js",
    "test:postinstall:prebuilt": "node tests/npm/test-postinstall-prebuilt.js",
    "test:npx:prebuilt": "node tests/npm/test-npx-prebuilt.js",
    "test:release:parity": "node tests/npm/test-release-install-parity.js",
    "test:npx:local": "node tests/npm/test-npx-local.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.3",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@types/node": {
      "undici-types": "6.23.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4"
  }
}
