{
  "schema_version": 1,
  "enforcement": {
    "schema_version": 1,
    "required_paths": ["hard-eng.gates.json"]
  },
  "families": {
    "typecheck": ["npm", "run", "typecheck"],
    "format": ["npm", "run", "format:check"],
    "lint": ["npm", "run", "lint"],
    "tests": ["npm", "test"],
    "fallow": [
      "npx",
      "--yes",
      "fallow@latest",
      "--fail-on-issues",
      "--format",
      "json",
      "--quiet",
      "--no-cache"
    ],
    "targeted": ["cargo", "test", "--all-targets", "--quiet"]
  },
  "phases": {
    "commit": ["typecheck", "format", "lint", "tests", "fallow", "targeted"],
    "push": ["typecheck", "format", "lint", "tests", "fallow", "targeted"],
    "ci": ["typecheck", "format", "lint", "tests", "fallow", "targeted"]
  }
}
